
<div class="container col-md-6 mt-5">
    <h1>Data Mahasiswa</h1>
    <table class="table">
        <thead>
            <tr>
            <th scope="col">No</th>
            <th scope="col">Nama</th>
            <th scope="col">Email</th>
            </tr>
        </thead>
        <tbody>
            <% let no = 1; %>
            <% mahasiswa.forEach(m => { %>
                <tr>
                    <th scope="row"><%= no++ %></th>
                    <td><%= m.nama %></td>
                    <td><%= m.email %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>